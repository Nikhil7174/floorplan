{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://floorplan.local/schema/property_plan.json",
  "title": "PropertyPlan (internal — not a case-study-published schema)",
  "type": "object",
  "required": ["schema_version", "tier", "capture_id", "rooms", "adjacencies", "warnings"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string" },
    "tier": { "enum": ["photos", "video", "lidar"] },
    "capture_id": { "type": "string" },
    "rooms": {
      "type": "array",
      "items": { "$ref": "#/$defs/room" }
    },
    "adjacencies": {
      "type": "array",
      "items": { "$ref": "#/$defs/adjacency" }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "interval": {
      "type": "object",
      "required": ["value", "lo", "hi", "unit", "reason"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": "number" },
        "lo": { "type": "number" },
        "hi": { "type": "number" },
        "unit": { "type": "string" },
        "reason": { "type": "string" }
      }
    },
    "opening": {
      "type": "object",
      "required": ["kind", "width_m", "t0_m", "t1_m"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["door", "window", "unknown"] },
        "width_m": { "$ref": "#/$defs/interval" },
        "t0_m": { "type": "number" },
        "t1_m": { "type": "number" }
      }
    },
    "wall": {
      "type": "object",
      "required": ["wall_id", "length_m", "heading_deg", "openings"],
      "additionalProperties": false,
      "properties": {
        "wall_id": { "type": "string" },
        "length_m": { "$ref": "#/$defs/interval" },
        "heading_deg": { "type": "number" },
        "openings": {
          "type": "array",
          "items": { "$ref": "#/$defs/opening" }
        }
      }
    },
    "room": {
      "type": "object",
      "required": [
        "room_id",
        "tier",
        "polygon_xy",
        "walls",
        "ceiling_height_m",
        "floor_area_m2",
        "warnings"
      ],
      "additionalProperties": false,
      "properties": {
        "room_id": { "type": "string" },
        "tier": { "enum": ["photos", "video", "lidar"] },
        "polygon_xy": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "type": "number" }
          }
        },
        "walls": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/wall" }
        },
        "ceiling_height_m": { "$ref": "#/$defs/interval" },
        "floor_area_m2": { "$ref": "#/$defs/interval" },
        "warnings": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "adjacency": {
      "type": "object",
      "required": ["room_a", "room_b", "via"],
      "additionalProperties": false,
      "properties": {
        "room_a": { "type": "string" },
        "room_b": { "type": "string" },
        "via": { "enum": ["door", "opening", "unknown"] },
        "shared_wall_a": { "type": ["string", "null"] },
        "shared_wall_b": { "type": ["string", "null"] }
      }
    }
  }
}
